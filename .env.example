# Market Data APIs
ALPHA_VANTAGE_API_KEY=API_KEY
EIA_API_KEY=API_KEY

# ---------------------------------------------------------------------------
# NexusAI-Client — Cloud AI Providers (Zero-Cost Free Tiers & Commercial)
# Configure one or more keys. The system uses automatic fallback across active keys.
# ---------------------------------------------------------------------------

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_API_KEY_PAY=

# Groq (Ultra-fast LPU inference: https://console.groq.com)
GROQ_API_KEY=

# Cerebras (High-throughput CS-3 inference: https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEY=

# Cohere (https://dashboard.cohere.com)
COHERE_API_KEY=

# Nvidia NIM (https://build.nvidia.com)
NVIDIA_API_KEY=

# OpenRouter (Unified router: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OrcaRouter (https://orcarouter.com)
ORCAROUTER_API_KEY=

# DeepSeek (Ultra-low cost reasoning: https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Optional — disable the 5MB capped LLM debug dump in data_cache/llm_debug_fail.txt
# TRADING_DEBUG_DUMP=0

# Dashboard Credentials
DASHBOARD_USER=admin
DASHBOARD_PASS=admin
